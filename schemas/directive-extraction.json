{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "directives": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "instruction": { "type": "string", "minLength": 4 },
                    "action": { "type": "string", "enum": ["add", "remove"] }
                },
                "required": ["instruction", "action"],
                "additionalProperties": false
            }
        }
    },
    "required": ["directives"],
    "additionalProperties": false
}
