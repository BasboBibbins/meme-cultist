{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "valid": { "type": "boolean" },
        "reason": { "type": "string" },
        "category": { "type": "string", "enum": ["legitimate", "spam", "abusive", "nonsense", "empty"] }
    },
    "required": ["valid", "reason", "category"],
    "additionalProperties": false
}
