# Discord Bot Configuration
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_application_id_here

# DeepSeek/OpenAI API
OPENAI_API_KEY=your_api_key_here
CONVO_MODEL=deepseek-v4-flash

# Google Gemini API (image understanding + image generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Workers AI (embeddings + image generation fallback)
# Without these, the KB, episodes, and archive fall back to lexical-only search.
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_KEY=your_cloudflare_api_key_here

# Optional
# Path to a Netscape-format cookies.txt, passed to yt-dlp as --cookies. Required for
# age-restricted YouTube videos. Export it from a logged-in browser; a raw cookie
# string will not work, and a path that does not exist is ignored silently by yt-dlp.
YTDLP_COOKIES=/absolute/path/to/cookies.txt
GENIUS_API_KEY=your_genius_key_here
GITHUB_TOKEN=your_github_token_here
BRAVE_API_KEY=your_brave_search_api_key
WEB_SEARCH_MONTHLY_BUDGET=900    # web_search calls per month, paced per UTC day (Brave bills $5 per 1,000)
WEB_SEARCH_DB_PATH=db/web_search.sqlite

# Polish milestone toggles
LOW_BUDGET_MODE=false            # true = cap tool depth to 2, skip critique, streaming, health probe, and optional classifiers
CRITIQUE_ENABLED=true            # false = skip the self-critique pass entirely
CRITIQUE_MODEL=deepseek-v4-flash # model for the self-critique pass (defaults to CONVO_MODEL)
BOOKMARK_EMOJI=📌              # reaction emoji for pinning facts
STREAMING_ENABLED=false          # true = stream chatbot responses into Discord with live edits

# LLM provider layer
LLM_DEFAULT_TIMEOUT_MS=60000     # per-call timeout applied by the router
LLM_MAX_RETRIES=3                # retry attempts per logical call
LLM_STREAM_IDLE_TIMEOUT_MS=30000 # max gap between streamed chunks before the stream is abandoned

# Rate limiting
MENTION_COOLDOWN=60              # seconds between @-mentions of the bot per user
CHAT_INFLIGHT_TIMEOUT_MS=120000  # max time a chatbot turn can be "in flight" before lock auto-clears
CHAT_BURST_LIMIT=12              # max chatbot messages per user in the rolling window
CHAT_BURST_WINDOW_MS=300000      # rolling window for chat burst cap (default 5 min)

# Message archive retention (pruned daily at midnight). 0 keeps the full history for search_history.
ARCHIVE_RETENTION_DAYS=0         # drop archived chunks older than N days (0 = disabled)
ARCHIVE_MAX_ROWS_PER_CHANNEL=0   # cap per-channel chunks at N rows (0 = disabled)
ARCHIVE_COMPACTION_ENABLED=false # true = summarize old chunks into episodes AND delete them from the archive
ARCHIVE_COMPACTION_THRESHOLD=100 # chunks per channel before compaction runs (only when enabled)
EPISODE_RECALL_MIN_SCORE=0.55    # cosine floor for recall_episode's semantic fallback
HISTORY_SEMANTIC_MIN_SCORE=0.70  # cosine floor for search_history's semantic matches

# Durable job queue
JOB_TICK_MS=2000                 # how often the queue polls for due jobs
JOB_BATCH_SIZE=5                 # max jobs claimed per tick
JOB_DB_PATH=db/jobs.sqlite

# Personas and self-serve roles
PERSONA_DB_PATH=db/personas.sqlite
SELF_ROLES_DB_PATH=db/self_roles.sqlite
ROLES_MODAL_TIMEOUT_MS=600000    # how long the /roles modal waits for a submission

# Reminders
REMINDER_MAX_ACTIVE_PER_USER=10  # max pending reminders per user
REMINDER_DM_FALLBACK=true        # true = DM first, fall back to channel if DMs are closed
REMINDER_MAX_GROUP_SIZE=25       # max members to DM for a role-targeted reminder

# Trick or treat (Halloween)
TRICK_OR_TREAT_IMPERSONATION_CHANNEL= # channel ID for impersonation posts; empty = the channel /trickortreat ran in
HALLOWEEN_FORCE_ACTIVE=false     # dev only: open /trickortreat outside October and remove its daily cooldown
TRICK_OR_TREAT_FORCE_OUTCOME=    # dev only: "treat" or a trick id (noTreat, theft, possessed, impersonation, spooked, timeout)

ADDITIONAL_NOUNS=your,additional,nouns,here,separated,by,commas
ADDITIONAL_ADJECTIVES=your,additional,adjectives,here,separated,by,commas

# Discord IDs (required for full functionality)
GUILD_ID=your_server_id_here
BANNED_ROLE=your_banned_role_id_here
OWNER_ID=your_owner_id_here
CHATBOT_CHANNELS=your_chatbot_channel_id_here,another_chatbot_channel_id_here # separate multiple channels with commas
TESTING_ROLE=your_testing_role_id_here
RULES_CHANNEL_ID=your_rules_channel_id_here
WELCOME_CHANNEL_ID=your_welcome_channel_id_here
RIP_CHANNEL_ID=your_rip_channel_id_here
PHANTOM_CHANNEL_CATEGORY=your_category_id_here
